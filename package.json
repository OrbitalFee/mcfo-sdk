{
  "name": "@orbitalfee/mcfo-sdk",
  "version": "0.1.0",
  "description": "Orbital Fee fee selection for Ethereum transactions: a typed client for the Orbital Fee API plus an ethers/viem submission helper. Never handles private keys.",
  "license": "MIT",
  "keywords": [
    "ethereum",
    "gas",
    "fees",
    "eip-1559",
    "ethers",
    "viem",
    "orbital-fee"
  ],
  "homepage": "https://github.com/OrbitalFee/mcfo-sdk#readme",
  "bugs": {
    "url": "https://github.com/OrbitalFee/mcfo-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrbitalFee/mcfo-sdk.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "ethers": "^6.0.0",
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
